#!/bin/sh
# Prints the libraries shipped in this content snap and their licenses,
# and reports where they are mounted for the Sweet Home 3D snap.
echo "Furniture libraries (SH3F):"
ls -1 "$SNAP"/furniture/*.sh3f 2>/dev/null || echo "  none"
echo
echo "Textures libraries (SH3T):"
ls -1 "$SNAP"/textures/*.sh3t 2>/dev/null || echo "  none"
echo
echo "License texts: see licenses/ directory of this content:"
ls -1 "$SNAP"/licenses/ 2>/dev/null
echo
echo "License summary:"
echo "  3DModels-Contributions  : Free Art License 1.3 (artlibre.org/licence/lal/en/)"
echo "  3DModels-BlendSwap-CC-0 : CC0 / Public Domain (creativecommons.org/choose/zero/)"
echo "  3DModels-BlendSwap-CC-BY: CC-BY 3.0 (creativecommons.org/licenses/by/3.0/)"
echo "  Textures-Contributions  : CC-BY 4.0 (creativecommons.org/licenses/by/4.0/)"
echo "  Textures-eTeksScopia    : CC-BY 4.0 (creativecommons.org/licenses/by/4.0/)"
