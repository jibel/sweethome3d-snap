#!/bin/sh
# Launcher for Sweet Home 3D running on the jlink-trimmed OpenJDK runtime
# built into the snap (the tarball's bundled Java 8 runtime is removed).

APP_DIR="$SNAP/sweethome3d"
JAVA_HOME="$SNAP/jre"
if [ ! -x "$JAVA_HOME/bin/java" ]; then
    echo "ERROR: no Java runtime found at $JAVA_HOME" >&2
    exit 1
fi

# Optional content snap with extra furniture/texture libraries. Build the
# applicationFolders property from the mounted content directories; when
# the content snap is not installed the folders are absent and the app
# falls back to its default catalogs only.
JAVA_ARGS=""
if [ -d "$SNAP/content/furniture" ] || [ -d "$SNAP/content/textures" ]; then
    JAVA_ARGS="-Dcom.eteks.sweethome3d.applicationFolders=$SNAP/content"
fi

exec "$JAVA_HOME/bin/java" -Xmx2g \
    $JAVA_ARGS \
    --add-opens java.desktop/sun.awt=ALL-UNNAMED \
    --add-opens java.desktop/sun.java2d=ALL-UNNAMED \
    --add-opens java.base/java.lang=ALL-UNNAMED \
    --enable-native-access=ALL-UNNAMED \
    -classpath "$APP_DIR/lib/SweetHome3D.jar:$APP_DIR/lib/Furniture.jar:$APP_DIR/lib/Textures.jar:$APP_DIR/lib/Examples.jar:$APP_DIR/lib/Help.jar:$APP_DIR/lib/batik-svgpathparser-1.7.jar:$APP_DIR/lib/jeksparser-calculator.jar:$APP_DIR/lib/iText-2.1.7.jar:$APP_DIR/lib/freehep-vectorgraphics-svg-2.1.1c.jar:$APP_DIR/lib/sunflow-0.07.3i.jar:$APP_DIR/lib/jmf.jar:$APP_DIR/lib/java3d-1.6/j3dcore.jar:$APP_DIR/lib/java3d-1.6/j3dutils.jar:$APP_DIR/lib/java3d-1.6/vecmath.jar:$APP_DIR/lib/java3d-1.6/gluegen-rt.jar:$APP_DIR/lib/java3d-1.6/jogl-java3d.jar:$APP_DIR/lib/jnlp.jar" \
    -Djava.library.path="$APP_DIR/lib/java3d-1.6:$APP_DIR/lib/yafaray" \
    -Djogamp.gluegen.UseTempJarCache=false \
    -Dcom.eteks.sweethome3d.applicationId=SweetHome3D#Installer \
    com.eteks.sweethome3d.SweetHome3D -open "$1"
